# ENDOLLM local configuration
# Replace these example paths with paths on your own system.
# Do NOT put API keys, passwords, or other secrets in this file.

ENDOMLLM_ROOT=/path/to/EndoMLLM
ENDOMLLM_KB_ROOT=/path/to/EndoMLLM/phase2_knowledge

OPGAGENT_ROOT=/path/to/OPGAgent
OPGAGENT_PYTHON=/path/to/opgagent_env/bin/python

# Optional output locations
# ENDOMLLM_OUTPUT_DIR=/path/to/output/phase4_outputs
# OPGAGENT_OUTPUT_DIR=/path/to/output/opgagent_outputs
